<?xml version="1.0" encoding="UTF-8"?>
<IODevice xmlns="http://www.io-link.com/IODD/2010/10" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <!-- Synthetic parser fixture, with no associated physical sensor. -->
  <ProfileBody>
    <DeviceIdentity vendorId="65535" deviceId="1">
      <DeviceVariantCollection>
        <DeviceVariant productId="SIM-SENSOR"><Name textId="sensor"/></DeviceVariant>
        <DeviceVariant productId="SIM-ALT"><Name textId="alt"/></DeviceVariant>
      </DeviceVariantCollection>
    </DeviceIdentity>
    <DeviceFunction>
      <DatatypeCollection>
        <Datatype id="PD" xsi:type="RecordT" bitLength="16">
          <RecordItem subindex="1" bitOffset="1">
            <SimpleDatatype xsi:type="IntegerT" bitLength="15"/>
            <Name textId="level"/>
          </RecordItem>
          <RecordItem subindex="2" bitOffset="0">
            <SimpleDatatype xsi:type="BooleanT"/>
            <Name textId="switch"/>
          </RecordItem>
        </Datatype>
      </DatatypeCollection>
      <VariableCollection>
        <StdVariableRef id="V_ProductID"/>
        <Variable id="V_SIM_Threshold" index="64" accessRights="rw" defaultValue="500">
          <Datatype xsi:type="IntegerT" bitLength="16">
            <ValueRange lowerValue="-1000" upperValue="1000"/>
            <SingleValue value="500"><Name textId="nominal"/></SingleValue>
          </Datatype>
          <Name textId="threshold"/>
        </Variable>
        <Variable id="V_SIM_Label" index="65" accessRights="ro">
          <Datatype xsi:type="StringT" fixedLength="32" encoding="UTF-8"/>
          <Name textId="sensorlabel"/>
        </Variable>
        <Variable id="V_SIM_Command" index="2" accessRights="wo">
          <Datatype xsi:type="UIntegerT" bitLength="8"/>
          <Name textId="command"/>
        </Variable>
      </VariableCollection>
      <ProcessDataCollection>
        <ProcessData id="PD">
          <ProcessDataIn id="IN" bitLength="16"><DatatypeRef datatypeId="PD"/></ProcessDataIn>
        </ProcessData>
      </ProcessDataCollection>
    </DeviceFunction>
  </ProfileBody>
  <ExternalTextCollection>
    <PrimaryLanguage xml:lang="en">
      <Text id="sensor" value="Simulated level sensor"/>
      <Text id="alt" value="Alternate simulated variant"/>
      <Text id="level" value="level"/>
      <Text id="switch" value="switch"/>
      <Text id="threshold" value="Synthetic threshold"/>
      <Text id="nominal" value="Nominal setting"/>
      <Text id="sensorlabel" value="Synthetic label"/>
      <Text id="command" value="Synthetic command (write-only)"/>
    </PrimaryLanguage>
  </ExternalTextCollection>
</IODevice>
